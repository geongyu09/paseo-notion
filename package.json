{
  "name": "paseo-notion",
  "description": "Browse Notion pages in the Explorer and read or edit them in a workspace tab.",
  "private": true,
  "version": "1.0.0",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "assets/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test shared/tree.test.mjs shared/edit.test.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.4",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geongyu09/paseo-notion.git"
  }
}
